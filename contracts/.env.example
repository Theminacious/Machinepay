# Monad testnet RPC (default: https://testnet-rpc.monad.xyz)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer key. Use a THROWAWAY testnet key only. Needs testnet MON for gas.
# Faucet: https://faucet.monad.xyz
PRIVATE_KEY=75db224817e4592badd5a658173c263fb61abf4d03d6df0154520628dd199e55

# Set after deploy.js prints it, so setupDemo.js targets the same contract.
# Optional: deploy.js also records the address in
# frontend/src/lib/deployments.json, which setupDemo.js falls back to.
CONTRACT_ADDRESS=

# Optional fleet overrides, read by scripts/fleet.js. Defaults shown; the seed
# is real native MON moved into the contract when a machine is created.
# SEED_EV=1.5
# SEED_CHARGER=1.5
# SEED_PROVIDER=0
# LIMIT_EV=2
# LIMIT_CHARGER=2
# LIMIT_PROVIDER=5

# Optional rolling daily budgets (total outgoing per UTC day). 0 means no cap.
# DAILY_EV=3
# DAILY_CHARGER=5
# DAILY_PROVIDER=0

# Optional on-device controller keys, so firmware can spend within its rules
# without holding the owner key. Empty means owner-only.
# CONTROLLER_EV=
# CONTROLLER_CHARGER=
# CONTROLLER_PROVIDER=

# Optional demoFlow.js amounts. Defaults shown.
# CHARGE_PRICE=0.5
# ENERGY_COST=1
# OVER_LIMIT=5
